# GEMINI_API_KEY: Optional server-side Gemini AI enrichment key (Prob8 works cleanly with or without this)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL (Vercel or Cloud Run URL)
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Maps JS, Places New, Geocoding, Street View)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Supabase Configuration (Auth, PostgreSQL, Storage, Edge Functions, Realtime)
# Automatically filled when linking Supabase inside Vercel Integrations
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Note: Web Push VAPID keys are silently auto-generated at boot (zero manual key config).
# Note: Skip Tracing uses Prob8's built-in zero-key county & public-records OSINT engine.
